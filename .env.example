# ==============================================================================
# INDIGO & THREAD - MONOREPO ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Brand: Indigo & Thread
# Market: India (INR ₹, GST Slabs: 5% for <= ₹1000, 12% for > ₹1000)

# NODE ENVIRONMENT
NODE_ENV=development
PORT=5000

# CLIENT URLS (for CORS & Cookie security)
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
API_URL=http://localhost:5000/api/v1

# DATABASE (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indigo_thread_db?schema=public

# REDIS (In-Memory Cache & Rate Limiting)
REDIS_URL=redis://localhost:6379

# AUTHENTICATION (JWT)
# Secrets should be 32+ characters random strings in production
JWT_ACCESS_SECRET=indigo_thread_super_secret_access_key_2026_dev_mode
JWT_REFRESH_SECRET=indigo_thread_super_secret_refresh_key_2026_dev_mode
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=indigo_thread_cookie_secure_signing_secret_dev

# PAYMENTS: RAZORPAY (India)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_dev

# CLOUDINARY (Product Image CDN)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# EMAIL NOTIFICATIONS (Resend or Nodemailer SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_placeholder_api_key
EMAIL_FROM=orders@indigothread.in
# If using Nodemailer SMTP fallback:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# GST & BUSINESS CONFIG
STORE_NAME="Indigo & Thread"
STORE_GSTIN="33AAAAA0000A1Z5"
STORE_STATE="Tamil Nadu"
STORE_STATE_CODE="33"
DEFAULT_CURRENCY=INR
